<Window x:Class="LiDPI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:LiDPI.UI.Controls"
        xmlns:ui="clr-namespace:LiDPI.UI"
        xmlns:vm="clr-namespace:LiDPI.UI.ViewModels"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        mc:Ignorable="d po"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="LiDPI" Width="400" Height="660"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/LiDPI;component/Assets/LiDPI.ico"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Text}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ui:StateToBrushConverter x:Key="StateBrush" />
        <ui:BoolToVisibilityConverter x:Key="BoolVis" />
        <ui:LogLevelToBrushConverter x:Key="LevelBrush" />

        <!-- shield glyph in a 24x24 box (same shape as the app icon) -->
        <PathGeometry x:Key="ShieldGlyph" po:Freeze="True"
                      Figures="M12,2 L20,5 V11 C20,16.5 16.6,20.6 12,22 C7.4,20.6 4,16.5 4,11 V5 Z" />

        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12,12,12" />
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatValue" TargetType="c:AnimatedNumber">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        </Style>

        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource Brush.Divider}" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Brush.WindowBorder}" BorderThickness="1"
            Background="{StaticResource Brush.Bg}">
        <Grid x:Name="RootGrid" ClipToBounds="True">

            <!-- ===== Ambient glow behind the power button ===== -->
            <Ellipse x:Name="AmbientIdle" Fill="{StaticResource Brush.BgGlowIdle}" Height="520"
                     VerticalAlignment="Top" Margin="-110,-100,-110,0" IsHitTestVisible="False" />
            <Ellipse x:Name="AmbientOn" Fill="{StaticResource Brush.BgGlow}" Height="520" Opacity="0"
                     VerticalAlignment="Top" Margin="-110,-100,-110,0" IsHitTestVisible="False" />

            <!-- ================= MAIN PAGE ================= -->
            <Grid x:Name="MainPage">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MainPageX" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- title bar -->
                <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource ShieldGlyph}" Fill="{StaticResource Brush.Accent}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="LiDPI" Margin="8,0,0,1" FontFamily="{StaticResource Font.Display}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="13.5"
                                ToolTip="Ayarlar" Click="OpenSettings_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="10"
                                ToolTip="Simge durumuna küçült" Click="Minimize_Click" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" FontSize="10"
                                ToolTip="Kapat" Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="MainScroll" Grid.Row="1" Focusable="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,0,20,18">

                        <!-- hero -->
                        <Grid x:Name="Hero" Height="232">
                            <c:PowerButton x:Name="Power" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           State="{Binding State}" Command="{Binding ToggleCommand}"
                                           AnimationsEnabled="{Binding IsViewActive}" />
                        </Grid>

                        <!-- status -->
                        <StackPanel x:Name="StatusBlock">
                            <c:CrossfadeText Height="36" Text="{Binding StatusText}"
                                             TextBrush="{Binding State, Converter={StaticResource StateBrush}}"
                                             TextElement.FontFamily="{StaticResource Font.Display}"
                                             TextElement.FontSize="26" TextElement.FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Brush.TextSecondary}"
                                       FontSize="13" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <Border x:Name="UptimePill" HorizontalAlignment="Center" Margin="0,10,0,0" Height="24"
                                    CornerRadius="12" Background="{StaticResource Brush.MintSoftBg}" Padding="11,0" Opacity="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Mint}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UptimeText}" Margin="7,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Mint}" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- mode segmented control -->
                        <Border x:Name="ModeCard" Height="46" Margin="0,16,0,0" Padding="4" CornerRadius="14"
                                IsEnabled="{Binding CanSwitchMode}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid x:Name="SegmentGrid" SizeChanged="SegmentGrid_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SegmentPill" Grid.ColumnSpan="2" HorizontalAlignment="Left"
                                        CornerRadius="10" Background="#FF1E1E28" BorderBrush="#FF2B2B36" BorderThickness="1">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="PillX" />
                                    </Border.RenderTransform>
                                    <Rectangle Height="2" Width="18" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom"
                                               Margin="0,0,0,4" Fill="{StaticResource Brush.AccentHorizontal}" />
                                </Border>
                                <RadioButton Style="{StaticResource SegmentButton}" Content="Tüm Uygulamalar"
                                             IsChecked="{Binding IsDivertMode}"
                                             ToolTip="Tüm uygulamaların trafiği korunur (WinDivert)" />
                                <RadioButton Grid.Column="1" Style="{StaticResource SegmentButton}" Content="Sadece Tarayıcı"
                                             IsChecked="{Binding IsProxyMode}"
                                             ToolTip="Yalnızca tarayıcılar, yerel proxy üzerinden" />
                            </Grid>
                        </Border>

                        <!-- profile selector -->
                        <Border x:Name="ProfileCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Button Style="{StaticResource CardHeaderButton}" Click="ProfileHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Brush.MintSoftBg}">
                                            <Viewbox Width="16" Height="16">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource ShieldGlyph}" Stroke="{StaticResource Brush.Accent}"
                                                          StrokeThickness="2" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="Profil" FontSize="11.5" Foreground="{StaticResource Brush.TextTertiary}" />
                                            <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource IconGlyph}" Text="&#xE70D;" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,4,0"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="ChevronRotate" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                                <c:RevealPanel x:Name="ProfileListHost" ClipToBounds="True">
                                    <StackPanel x:Name="ProfileListInner" VerticalAlignment="Top" Margin="8,0,8,8">
                                        <Rectangle Style="{StaticResource Divider}" Margin="8,0,8,6" />
                                        <ListBox x:Name="ProfileList" Style="{StaticResource PlainList}"
                                                 ItemContainerStyle="{StaticResource ProfileItem}"
                                                 ItemsSource="{Binding Profiles}"
                                                 SelectedItem="{Binding SelectedProfile}"
                                                 PreviewMouseLeftButtonUp="ProfileList_PreviewMouseLeftButtonUp">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.TextPrimary}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0"
                                                                   Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </c:RevealPanel>
                            </StackPanel>
                        </Border>

                        <!-- error card (replaces stats while in error) -->
                        <Border x:Name="ErrorCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,12"
                                Background="{StaticResource Brush.RedSoftBg}" BorderBrush="{StaticResource Brush.RedSoftBorder}"
                                Visibility="{Binding IsError, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE783;" FontSize="16"
                                           Foreground="{StaticResource Brush.Red}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="Bağlantı kurulamadı" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource Brush.Red}" />
                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Margin="0,3,0,0"
                                               Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"
                                               MaxHeight="50" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ErrorMessage}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource DangerButton}" Content="Tekrar dene"
                                        Command="{Binding RetryCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- stats -->
                        <Grid x:Name="StatsRow" Margin="0,12,0,0"
                              Visibility="{Binding IsError, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8AB;" FontSize="12" Foreground="{StaticResource Brush.Mint}" />
                                        <TextBlock Style="{StaticResource StatLabel}" Text="Paket" />
                                    </StackPanel>
                                    <c:StableSlot><c:AnimatedNumber Style="{StaticResource StatValue}" Value="{Binding Packets}" /></c:StableSlot>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE71B;" FontSize="12" Foreground="{StaticResource Brush.Cyan}" />
                                        <TextBlock Style="{StaticResource StatLabel}" Text="Bağlantı" />
                                    </StackPanel>
                                    <c:StableSlot><c:AnimatedNumber Style="{StaticResource StatValue}" Value="{Binding Connections}" /></c:StableSlot>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE774;" FontSize="12" Foreground="{StaticResource Brush.Mint}" />
                                        <TextBlock Style="{StaticResource StatLabel}" Text="DNS" />
                                    </StackPanel>
                                    <c:StableSlot><c:AnimatedNumber Style="{StaticResource StatValue}" Value="{Binding DnsQueries}" /></c:StableSlot>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- footer -->
                        <Grid x:Name="Footer" Margin="0,14,0,0">
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OpenLogs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8FD;" FontSize="12" />
                                    <TextBlock Text="Kayıtlar" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{StaticResource Brush.TextTertiary}">
                                <Run Text="v" /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= SETTINGS PAGE ================= -->
            <Grid x:Name="SettingsPage" Background="{StaticResource Brush.Bg}" Visibility="Hidden">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SettingsX" X="400" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="13"
                                ToolTip="Geri" Click="CloseSettings_Click" />
                        <TextBlock Text="Ayarlar" Margin="6,0,0,1" FontFamily="{StaticResource Font.Display}"
                                   FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="10"
                                ToolTip="Simge durumuna küçült" Click="Minimize_Click" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" FontSize="10"
                                ToolTip="Kapat" Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,6,20,22">

                        <TextBlock Style="{StaticResource Caption}" Text="GENEL" />
                        <Border Style="{StaticResource Card}" Padding="16,2">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Margin="0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Windows ile başlat" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Oturum açıldığında tepside sessizce başlar" />
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimized}" Margin="0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Simge durumunda başlat" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Açılışta pencere yerine yalnızca tepsi simgesi" />
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoConnectOnLaunch}" Margin="0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Açılışta otomatik bağlan" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Uygulama açılır açılmaz korumayı başlatır" />
                                    </StackPanel>
                                </CheckBox>
                                <Rectangle Style="{StaticResource Divider}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}" Margin="0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="Kapatınca tepsiye küçült" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Pencereyi kapatmak korumayı sonlandırmaz" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}" Text="DNS SAĞLAYICISI (DoH)" Margin="4,22,0,8" />
                        <Border Style="{StaticResource Card}" Padding="16,14,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,0,8,12"
                                           Text="DNS sorguları şifreli olarak bu sağlayıcı üzerinden çözülür. Değişiklik bağlıyken hemen uygulanır." />
                                <ListBox Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ChipItem}"
                                         ItemsSource="{Binding DohProviderList}" SelectedItem="{Binding SelectedDoh}"
                                         DisplayMemberPath="Name">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}" Text="HAKKINDA" Margin="4,22,0,8" />
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="42" Height="42">
                                        <Border CornerRadius="11" Background="#FF0E0E14" BorderBrush="#FF262630" BorderThickness="1" />
                                        <Viewbox Width="32" Height="32">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource ShieldGlyph}" Fill="{StaticResource Brush.Accent}" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Li" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="11"
                                                   Foreground="{StaticResource Brush.Bg}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Margin="0,0,0,2" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="LiDPI" FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextSecondary}">
                                            <Run Text="Sürüm " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,12,0,0"
                                           Text="DPI tabanlı erişim engellerini aşmak için hafif ve açık bir araç." />
                                <TextBlock Margin="0,8,0,0" FontSize="12.5">
                                    <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/LiebertDev/LiDPI">GitHub'da görüntüle</Hyperlink>
                                </TextBlock>
                                <Rectangle Style="{StaticResource Divider}" Margin="0,14,0,12" />
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap" LineHeight="17">
                                    <Run Text="Bu uygulama, LGPLv3 / GPLv2 lisanslı WinDivert (© basil00) sürücüsünü değiştirilmemiş haliyle kullanır. Kaynak kodu:" />
                                    <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/basil00/WinDivert">github.com/basil00/WinDivert</Hyperlink><Run Text=". Ayrıntılar için THIRD_PARTY_NOTICES dosyasına bakın. LiDPI olduğu gibi, hiçbir garanti olmaksızın sunulur." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= LOG DRAWER ================= -->
            <Grid x:Name="LogOverlay" Visibility="Hidden">
                <Border x:Name="LogBackdrop" Background="{StaticResource Brush.Backdrop}" Opacity="0"
                        MouseLeftButtonDown="LogBackdrop_MouseLeftButtonDown" />
                <Border x:Name="LogSheet" VerticalAlignment="Bottom" Height="450" CornerRadius="20,20,0,0"
                        Background="#FF101016" BorderBrush="{StaticResource Brush.CardBorder}" BorderThickness="1,1,1,0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="LogSheetY" Y="450" />
                    </Border.RenderTransform>
                    <Grid Margin="16,8,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Width="36" Height="4" CornerRadius="2" Background="#FF2C2C37" HorizontalAlignment="Center" />
                        <Grid Grid.Row="1" Margin="2,10,0,12">
                            <TextBlock Text="Kayıtlar" FontFamily="{StaticResource Font.Display}" FontSize="15"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding CopyLogsCommand}" Padding="10,5" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8C8;" FontSize="11.5" />
                                        <TextBlock Text="Kopyala" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10"
                                        ToolTip="Kapat" Click="CloseLogs_Click" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" Background="#FF0B0B0F" CornerRadius="12" BorderBrush="{StaticResource Brush.CardBorder}"
                                BorderThickness="1" Padding="10,8,4,8">
                            <Grid>
                                <ListBox x:Name="LogList" Style="{StaticResource LogList}" ItemsSource="{Binding Logs}"
                                         ItemContainerStyle="{StaticResource LogItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                                       Margin="0,0,8,0" Foreground="{StaticResource Brush.TextSecondary}">
                                                <Run Text="{Binding Time, StringFormat=HH:mm:ss, Mode=OneWay}" Foreground="{StaticResource Brush.TextTertiary}" />
                                                <Run Text="{Binding Level, Mode=OneWay}" Foreground="{Binding Level, Converter={StaticResource LevelBrush}, Mode=OneWay}" />
                                                <Run Text="{Binding Message, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Henüz kayıt yok." HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{StaticResource Brush.TextTertiary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
