<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- ===== Palette ===== -->
    <Color x:Key="C.Bg">#FF0A0A0E</Color>
    <Color x:Key="C.Surface">#FF0F0F14</Color>
    <Color x:Key="C.Card">#FF121218</Color>
    <Color x:Key="C.CardHover">#FF17171F</Color>
    <Color x:Key="C.CardBorder">#FF1E1E26</Color>
    <Color x:Key="C.WindowBorder">#FF1F1F27</Color>
    <Color x:Key="C.Divider">#FF1A1A22</Color>
    <Color x:Key="C.TextPrimary">#FFE6E6EB</Color>
    <Color x:Key="C.TextSecondary">#FF8A8A99</Color>
    <Color x:Key="C.TextTertiary">#FF5C5C6B</Color>
    <Color x:Key="C.Mint">#FF2EE6A6</Color>
    <Color x:Key="C.Cyan">#FF22C3E6</Color>
    <Color x:Key="C.Amber">#FFF5B544</Color>
    <Color x:Key="C.Red">#FFFF5C7A</Color>
    <Color x:Key="C.Stopped">#FF3A3A46</Color>

    <!-- ===== Brushes (frozen) ===== -->
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource C.Bg}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource C.Surface}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource C.Card}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="{StaticResource C.CardHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="{StaticResource C.CardBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.WindowBorder" Color="{StaticResource C.WindowBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource C.Divider}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource C.TextPrimary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource C.TextSecondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource C.TextTertiary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Mint" Color="{StaticResource C.Mint}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Cyan" Color="{StaticResource C.Cyan}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Amber" Color="{StaticResource C.Amber}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Red" Color="{StaticResource C.Red}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Stopped" Color="{StaticResource C.Stopped}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.StoppedIcon" Color="#FF6A6A78" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#14FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.PressOverlay" Color="#0CFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.RedSoftBg" Color="#1AFF5C7A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.RedSoftBorder" Color="#40FF5C7A" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.MintSoftBg" Color="#142EE6A6" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Backdrop" Color="#B3050507" po:Freeze="True" />

    <LinearGradientBrush x:Key="Brush.Accent" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource C.Mint}" Offset="0" />
        <GradientStop Color="{StaticResource C.Cyan}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AccentHorizontal" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="{StaticResource C.Mint}" Offset="0" />
        <GradientStop Color="{StaticResource C.Cyan}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AccentVertical" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="{StaticResource C.Mint}" Offset="0" />
        <GradientStop Color="{StaticResource C.Cyan}" Offset="1" />
    </LinearGradientBrush>

    <!-- Subtle background glow behind the power button -->
    <RadialGradientBrush x:Key="Brush.BgGlow" po:Freeze="True">
        <GradientStop Color="#2A2EE6A6" Offset="0" />
        <GradientStop Color="#1022C3E6" Offset="0.45" />
        <GradientStop Color="#0022C3E6" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.BgGlowIdle" po:Freeze="True">
        <GradientStop Color="#14A0A0C0" Offset="0" />
        <GradientStop Color="#06A0A0C0" Offset="0.45" />
        <GradientStop Color="#00A0A0C0" Offset="1" />
    </RadialGradientBrush>

    <!-- ===== Typography ===== -->
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
