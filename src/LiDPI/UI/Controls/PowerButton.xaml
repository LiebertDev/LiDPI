<UserControl x:Class="LiDPI.UI.Controls.PowerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:l="clr-namespace:LiDPI.Localization"
             mc:Ignorable="po"
             Width="236" Height="236">
    <UserControl.Resources>
        <!-- power glyph in a 24x24 box -->
        <PathGeometry x:Key="PowerGlyph" po:Freeze="True"
                      Figures="M 6.86,6.87 A 8,8 0 1 0 17.14,6.87 M 12,3 L 12,12" />

        <RadialGradientBrush x:Key="GlowBrush" po:Freeze="True">
            <GradientStop Color="#702EE6A6" Offset="0.62" />
            <GradientStop Color="#2A22C3E6" Offset="0.80" />
            <GradientStop Color="#0022C3E6" Offset="1" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="CoreFill" StartPoint="0.5,0" EndPoint="0.5,1" po:Freeze="True">
            <GradientStop Color="#FF1C1C25" Offset="0" />
            <GradientStop Color="#FF101016" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CoreBevel" StartPoint="0.5,0" EndPoint="0.5,1" po:Freeze="True">
            <GradientStop Color="#26FFFFFF" Offset="0" />
            <GradientStop Color="#00FFFFFF" Offset="0.5" />
            <GradientStop Color="#0AFFFFFF" Offset="1" />
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="CoreTint" po:Freeze="True">
            <GradientStop Color="#222EE6A6" Offset="0" />
            <GradientStop Color="#0022C3E6" Offset="1" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="SpinnerBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
            <GradientStop Color="#00F5B544" Offset="0" />
            <GradientStop Color="#FFF5B544" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- breathing glow -->
        <Ellipse x:Name="Glow" Fill="{StaticResource GlowBrush}" Opacity="0" IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- click ripple -->
        <Ellipse x:Name="Ripple" Width="196" Height="196" StrokeThickness="2" Stroke="{StaticResource Brush.Accent}"
                 Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RippleScale" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Button x:Name="Btn" Style="{StaticResource BareButton}" Width="196" Height="196"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                AutomationProperties.Name="{l:T PowerButtonName}">
            <Grid x:Name="Body" Width="196" Height="196" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BodyScale" />
                </Grid.RenderTransform>

                <!-- rings -->
                <Ellipse x:Name="RingTrack" StrokeThickness="2.5" Stroke="#FF24242E" IsHitTestVisible="False" />
                <Ellipse x:Name="RingOn" StrokeThickness="3" Stroke="{StaticResource Brush.Accent}" Opacity="0" IsHitTestVisible="False" />
                <Ellipse x:Name="RingError" StrokeThickness="2.5" Stroke="{StaticResource Brush.Red}" Opacity="0" IsHitTestVisible="False" />
                <Path x:Name="Spinner" Data="M 98,1.5 A 96.5,96.5 0 0 1 194.5,98" StrokeThickness="3"
                      Stroke="{StaticResource SpinnerBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Opacity="0" IsHitTestVisible="False">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" CenterX="98" CenterY="98" />
                    </Path.RenderTransform>
                </Path>

                <!-- core -->
                <Ellipse x:Name="Core" Width="166" Height="166" Fill="{StaticResource CoreFill}"
                         Stroke="#FF262631" StrokeThickness="1" />
                <Ellipse x:Name="CoreTintLayer" Width="166" Height="166" Fill="{StaticResource CoreTint}" Opacity="0" IsHitTestVisible="False" />
                <Ellipse Width="164" Height="164" Stroke="{StaticResource CoreBevel}" StrokeThickness="1" IsHitTestVisible="False" />

                <!-- icons, one per state family; only opacity animates -->
                <Viewbox x:Name="IconOff" Width="54" Height="54" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource PowerGlyph}" Stroke="{StaticResource Brush.StoppedIcon}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <Viewbox x:Name="IconBusy" Width="54" Height="54" Opacity="0" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource PowerGlyph}" Stroke="{StaticResource Brush.Amber}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <Viewbox x:Name="IconOn" Width="54" Height="54" Opacity="0" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource PowerGlyph}" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <Viewbox x:Name="IconError" Width="54" Height="54" Opacity="0" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource PowerGlyph}" Stroke="{StaticResource Brush.Red}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </Button>
    </Grid>
</UserControl>
